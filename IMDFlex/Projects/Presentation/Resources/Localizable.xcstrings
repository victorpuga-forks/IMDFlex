    "mapEditor.alert.missingParent.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This feature needs another feature to exist first. Check the References requirement above, add that feature, then finish this draft again."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 기능을 사용하려면 다른 기능이 먼저 있어야 합니다. 위의 참조 요구 사항을 확인하고 해당 기능을 추가한 후 이 초안을 다시 완료하세요."
          }
        }
      }
    },
